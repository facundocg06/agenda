<odoo>
    <data noupdate="1">
        <!-- Grupo para Estudiantes -->
        <record id="group_student" model="res.groups">
            <field name="name">Estudiante</field>
        </record>

        <!-- Grupo para Tutores -->
        <record id="group_tutor" model="res.groups">
            <field name="name">Tutor</field>
        </record>

        <!-- Grupo para Administradores (o roles que pueden ver todo) -->
        <record id="group_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
