<odoo>
    <data>
        <!-- Vista de lista -->
        <record id="comunicado_tree_view" model="ir.ui.view">
            <field name="name">comunicado.tree.view</field>
            <field name="model">agenda.comunicado</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="asunto" />
                    <field name="contenido" />
                    <field name="fecha_envio"/> 
                    <field name="estado"/>  
                    <field name="creado_por_id"/>         
                </tree>        
            </field>
        </record>

        <!-- Vista de formulario -->
        <record id="comunicado_form_view" model="ir.ui.view">
            <field name="name">comunicado.form.view</field>
            <field name="model">agenda.comunicado</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="asunto"/>
                    </group>
                    <group>
                        <field name="contenido"/>
                    </group>
                    <group string="Archivos">
                        <field name="multimedia_ids" widget="many2many_binary" options="{'file': 'file'}"/>
                    </group>
                    <group>
                        <field name="fecha_envio"/>
                    </group>
                    
                    <!-- Grupo para destinatarios -->
                    <group string="Destinatarios">                        
                        <field name="destinatario_tipo" widget="many2many_tags" options="{'no_create': True}"/>
                        <!-- Aplicar dominio dinámico basado en el usuario actual -->
                        <field name="grados_ids" widget="many2many_tags" options="{'no_create': True}"/>

                    </group>
                </form>
            </field>
        </record>
