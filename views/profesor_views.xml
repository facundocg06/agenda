<odoo>
    <data>
        <!-- Vista de Lista (Árbol) para Profesores -->
        <record id="view_profesor_tree" model="ir.ui.view">
            <field name="name">school.profesor.tree</field>
            <field name="model">school.profesor</field>
            <field name="arch" type="xml">
                <tree string="Profesores">
                    <field name="name" string="Nombre Completo"/>
                    <field name="cursos_ids" string="Cursos Asignados" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <!-- Vista de Formulario para Profesores -->
        <record id="view_profesor_form" model="ir.ui.view">
            <field name="name">school.profesor.form</field>
            <field name="model">school.profesor</field>
            <field name="arch" type="xml">
                <form string="Profesor">
                    <sheet>
                        <group>
                            <field name="name" string="Nombre Completo" required="1"/>
                            <field name="cursos_ids" widget="many2many_tags" string="Cursos Asignados"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
