<odoo>
    <data>
        <!-- Vista Tree para Estudiantes -->
        <record id="view_school_estudiante_tree" model="ir.ui.view">
            <field name="name">school.estudiante.tree</field>
            <field name="model">school.estudiante</field>
            <!-- <field name="groups_id" eval="[(6, 0, [ref('agenda.group_admin')])]"/> -->
            <field name="groups_id" eval="[(6, 0, [ref('agenda.group_admin')])]"/>
            <field name="arch" type="xml">
                <tree string="Estudiantes">
                    <field name="name"/>
                    <field name="curso_id"/>
                    <field name="paralelo_id"/>
                </tree>
            </field>
        </record>

         <record id="view_school_estudiante_form" model="ir.ui.view">
            <field name="name">school.estudiante.form</field>
            <field name="model">school.estudiante</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="curso_id"/>
                            <field name="paralelo_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
